# Gemini API key (aistudio.google.com) — required for roast generation
GEMINI_API_KEY=

# Optional: override default model (gemini-3.5-flash, falls back to gemini-flash-lite-latest)
# GEMINI_MODEL=gemini-flash-lite-latest

# OAuth — write these via ./scripts/setup-google-oauth.sh
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: app base URL, default http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: force Secure cookies on localhost (test production cookie path)
# RT_COOKIES=true
