# Gemini API key (aistudio.google.com) — required for roast generation
GEMINI_API_KEY=

# Optional: override default model (gemini-3.5-flash, falls back to gemini-flash-lite-latest)
# GEMINI_MODEL=gemini-flash-lite-latest

# OAuth — write these via ./scripts/setup-google-oauth.sh
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: app base URL, default http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: force Secure cookies on localhost (test production cookie path)
# RT_COOKIES=true

# Sessions: signs the sealed session cookie. Optional locally (per-process
# random fallback); required on Cloudflare — scripts/setup-cloudflare.sh
# generates and uploads one.
# SESSION_SECRET=

# Turnstile: optional locally — verification is skipped when unset. The test
# pair always passes; setup-cloudflare.sh writes it into .dev.vars.
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional: daily roast budget on the free Gemini tier (default 15)
# DAILY_ROAST_BUDGET=15

# Note: `vinext dev` reads .dev.vars (written by scripts/setup-cloudflare.sh)
# while `next dev` reads .env.local. Keep both for parity.
